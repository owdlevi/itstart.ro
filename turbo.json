{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      // Strict mode hides undeclared variables from the build. These change
      // what's built, so they're in the hash; the secrets only pass through.
      "env": ["DESIGN_FIXTURES", "BETTER_AUTH_URL", "VERCEL", "VERCEL_ENV"],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BLOB_*",
        "GOOGLE_CLIENT_*",
        "GITHUB_CLIENT_*"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
