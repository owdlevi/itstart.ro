{
  "name": "itstart.ro",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate"
  },
  "devDependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
