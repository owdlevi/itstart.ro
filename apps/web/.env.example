# Postgres, pooled (Neon's pooled URL on Vercel).
DATABASE_URL=

# Better Auth. Generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# OAuth apps. Redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google and …/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 1 freezes the clock at the design fixtures' time and enables /dev/login-as.
# Never set in production.
DESIGN_FIXTURES=

# Vercel Blob (itstart-ro-blob, public, fra1): screenshots and profile pictures.
# Without a token, uploads go to apps/web/.data/capturi (off Vercel only).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
